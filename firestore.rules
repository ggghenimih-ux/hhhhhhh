rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'productId', 'name', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'name', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 3000
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow get: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'name', 'firstName', 'phone', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'CUSTOMER';
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          && request.resource.data.keys().hasOnly([
            'email', 'name', 'firstName', 'phone', 'role', 'createdAt', 'updatedAt'
          ]));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}