rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'productId', 'name', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'name', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 3000
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      function isOrderStaff() {
        return isAdmin()
          || (signedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TECHNICIEN');
      }

      function nullableString(value, maxLength) {
        return value == null || (value is string && value.size() <= maxLength);
      }

      function validOrderCreate() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail',
            'governorate', 'city', 'delegation', 'address', 'notes',
            'paymentMethod', 'items', 'subtotal', 'deliveryFee', 'grandTotal',
            'status', 'orderStatus', 'createdAt'
          ])
          && data.keys().hasOnly([
            'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail',
            'governorate', 'city', 'delegation', 'address', 'notes',
            'paymentMethod', 'items', 'subtotal', 'deliveryFee', 'grandTotal',
            'status', 'orderStatus', 'createdAt'
          ])
          && (data.userId == null || (signedIn() && data.userId == request.auth.uid))
          && data.orderNumber is string
          && data.orderNumber.size() == 10
          && data.orderNumber.matches('^ORD-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$')
          && data.customerName is string
          && data.customerName.size() > 0
          && data.customerName.size() <= 120
          && data.customerPhone is string
          && data.customerPhone.size() >= 8
          && data.customerPhone.size() <= 20
          && data.customerPhone.matches('^[24579][0-9]{7}$')
          && nullableString(data.customerEmail, 254)
          && data.governorate is string
          && data.governorate.size() > 0
          && data.governorate.size() <= 100
          && data.city is string
          && data.city.size() > 0
          && data.city.size() <= 120
          && nullableString(data.delegation, 120)
          && data.address is string
          && data.address.size() > 0
          && data.address.size() <= 500
          && nullableString(data.notes, 1000)
          && data.paymentMethod in ['cod', 'bank_transfer']
          && data.items is list
          && data.items.size() >= 1
          && data.items.size() <= 100
          && data.subtotal is number
          && data.subtotal >= 0
          && data.subtotal <= 10000000
          && data.deliveryFee is number
          && data.deliveryFee >= 0
          && data.deliveryFee <= 10000000
          && data.grandTotal is number
          && data.grandTotal >= 0
          && data.grandTotal <= 10000000
          && data.status == 'pending'
          && data.orderStatus == 'pending'
          && data.createdAt is string
          && data.createdAt.size() > 0
          && data.createdAt.size() <= 40
&& data.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$');      }

      function validOrderUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isOrderStaff()
          && changed.hasOnly([
            'customerName', 'customerPhone', 'customerEmail', 'governorate',
            'city', 'delegation', 'address', 'notes', 'status', 'orderStatus',
            'paymentStatus', 'updatedAt', 'archivedAt', 'deletedAt', 'seenAt',
            'trackingNumber', 'carrierName'
          ])
          && (!changed.hasAny(['seenAt'])
            || (request.resource.data.seenAt is string
              && request.resource.data.seenAt.size() <= 40));
      }

      allow create: if validOrderCreate();
      allow get: if isOrderStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isOrderStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if validOrderUpdate();
      allow delete: if isOrderStaff();
    }

    match /users/{userId} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'name', 'firstName', 'phone', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'CUSTOMER';
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          && request.resource.data.keys().hasOnly([
            'email', 'name', 'firstName', 'phone', 'role', 'createdAt', 'updatedAt'
          ]));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}