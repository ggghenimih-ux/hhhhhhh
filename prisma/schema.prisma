// Prisma Schema for Outils Réparation GSM Tunisie
// Supports SQLite for local dev & seamless migration to PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  role         String   @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  emailVerifiedAt DateTime?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id                String      @id @default(uuid())
  name              String
  slug              String      @unique
  shortDescription  String      @default("")
  description       String      @default("")
  priceTND          Float
  compareAtPriceTND Float?
  category          String
  image             String
  images            String      @default("[]") // JSON string of image URLs
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  sku               String?     @default("")
  brand             String?     @default("")
  warranty          String?     @default("")
  rating            Float       @default(5.0)
  reviewsCount      Int         @default(0)
  isNew             Boolean     @default(false)
  isFeatured        Boolean     @default(false)
  isActive          Boolean     @default(true)
  deletedAt         DateTime?
  specs             String      @default("{}") // JSON string of technical specifications
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reviews           Review[]
  orderItems        OrderItem[]

  @@map("products")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  userId        String?
  customerName  String
  customerPhone String
  customerEmail String?
  governorate   String
  delegation    String?
  address       String
  notes         String?
  subtotalTND   Float
  shippingTND   Float
  totalTND      Float
  status        String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentMethod String      @default("cod")     // cod, bank_transfer, online
  paymentStatus String      @default("pending") // pending, paid, failed
  statusHistory String      @default("[]")     // JSON string of status transitions with timestamp
  archivedAt    DateTime?
  archivedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User?       @relation(fields: [userId], references: [id])
  items         OrderItem[]

  @@index([archivedAt, createdAt])
  @@map("orders")
}

model AdminOrderExport {
  id             String   @id @default(uuid())
  actorId        String
  tokenHash      String   @unique
  fromDate       DateTime
  toDate         DateTime
  snapshotAt     DateTime
  orderIdsJson   String
  orderCount     Int
  exportedAt     DateTime @default(now())
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([actorId, expiresAt])
  @@map("admin_order_exports")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  targetType  String
  targetCount Int      @default(0)
  outcome     String
  details     String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  priceTND    Float
  quantity    Int
  totalTND    Float

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  name       String
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model StoreSettings {
  id                        String   @id @default("default")
  storeName                 String   @default("Outils Réparation GSM Tunisie")
  storeDescription          String   @default("Plateforme spécialisée dans la vente d'équipements et outils de réparation pour smartphones en Tunisie.")
  logoUrl                   String   @default("/logo.jpg")
  faviconUrl                String   @default("/logo.jpg")
  phone                     String   @default("+216 26 383 876")
  whatsapp                  String   @default("+216 26 383 876")
  email                     String   @default("contact@reparation-gsm.tn")
  address                   String   @default("Tunis,tunis")
  facebookUrl               String   @default("https://facebook.com/outils.reparation.gsm")
  instagramUrl              String   @default("https://instagram.com/outils.reparation.gsm")
  tiktokUrl                 String   @default("https://tiktok.com/@outilsreparationgsm")
  youtubeUrl                String   @default("https://youtube.com/@outilsreparationgsm")
  workingHours              String   @default("Mar - Dim: 08:00 - 18:00 | Lundi: Fermé")
  defaultShippingTND        Float    @default(7.0)
  freeShippingThresholdTND  Float    @default(300.0)
  currency                  String   @default("DT")
  primaryColor              String   @default("#ea580c")
  secondaryColor            String   @default("#0f172a")
  heroTitle                 String   @default("معدات وأدوات صيانة الهواتف الذكية للمحترفين")
  heroSubtitle              String   @default("محطات لحام دقيقة، ميكروسكوبات ثلاثية العيون، مبرمجات سوفتوير، ومزودات طاقة أصلية مع توصيل سريع 24/48 ساعة وضمان حقيقي.")
  heroButtonText            String   @default("عرض جميع المنتجات")
  heroButtonLink            String   @default("products")
  heroImage                 String   @default("/logo.jpg")
  updatedAt                 DateTime @updatedAt

  @@map("store_settings")
}
