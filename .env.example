# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# ENVIRONMENT & SERVER
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# ==============================================================================
# DATABASE (Prisma with SQLite for dev, PostgreSQL for production)
# ==============================================================================
# Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/gsm_db?schema=public"

# ==============================================================================
# AUTHENTICATION (JWT)
# ==============================================================================
# REQUIRED in production, min 32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ==============================================================================
# STORE & TUNISIAN SHIPPING DEFAULTS
# ==============================================================================
DEFAULT_SHIPPING_TND=7.0
FREE_SHIPPING_THRESHOLD_TND=300.0

# ==============================================================================
# SEED / ADMIN (used by `npm run db:seed`; never commit real values)
# ==============================================================================
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=   # at least 12 chars; if empty a random one is generated and printed
# Cookies: set to true ONLY if the site is embedded in a cross-site iframe (requires HTTPS)
# COOKIE_SAMESITE_NONE=false
# CORS_ORIGIN accepts a comma-separated list of allowed origins (required in production if frontend is on another origin)

# Copy this file to .env, then replace these placeholders with values from
# Firebase Console > Project settings > General. Do not commit the real .env.
#
# Firebase Admin verifies client ID tokens with the project ID; no service-account
# key is required for this verification flow.
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="MY_FIREBASE_MEASUREMENT_ID"
