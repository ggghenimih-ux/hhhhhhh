# ==============================================================================
# NOTIFICATIONS WHATSAPP (nouvelle commande → votre WhatsApp)
# ==============================================================================
# Votre numéro (format international, sans +) : 216XXXXXXXX
ADMIN_WHATSAPP_NUMBER=216XXXXXXXX
# cloud = API officielle Meta (recommandé) | callmebot = gratuit, non officiel | none = désactivé
WHATSAPP_PROVIDER=none

# --- Si WHATSAPP_PROVIDER=cloud ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v23.0
# Nom d'un modèle (template) approuvé par Meta, avec 5 variables ({{1}} n° commande, {{2}} nom,
# {{3}} téléphone, {{4}} total, {{5}} gouvernorat). Recommandé : sans modèle, le message n'est livré
# que si vous avez écrit au numéro professionnel dans les dernières 24 h.
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=fr

# --- Si WHATSAPP_PROVIDER=callmebot ---
# CALLMEBOT_API_KEY=

# Lien ajouté en bas du message WhatsApp (page admin des commandes), optionnel
# ADMIN_URL=https://votre-domaine.tn/admin
